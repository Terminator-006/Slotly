# Required in production. Generate one with: openssl rand -base64 32
# In development a throwaway default is used (with a console warning).
JWT_SECRET=

# Postgres connection string. REQUIRED in production (a production start without it fails fast).
#   Neon (free):  postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Local:        postgresql://postgres:postgres@127.0.0.1:5432/slotly
# Use the pooled host (contains -pooler) on serverless platforms.
# Leave it unset in development to use an in-memory Postgres (PGlite) that is seeded with the demo
# business and resets on restart. DATABASE_URL=pglite://memory forces that mode explicitly.
DATABASE_URL=

# Optional: max connections per server instance. Default 5.
# PG_POOL_MAX=5

# Set to 1 to make sure the demo business (slug: demo-barber) exists on startup.
# Idempotent: it uses fixed ids, so it is safe on every cold start and across instances.
# SLOTLY_DEMO_SEED=1

# Email. First match wins:
#   1. RESEND_API_KEY set          -> send through Resend
#   2. SMTP_USER + SMTP_PASS set   -> send through SMTP (Gmail by default)
#   3. neither                     -> print emails to the server console
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, spaces optional).
# Use that, NOT your normal Gmail password.
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
#
# RESEND_API_KEY=
# MAIL_FROM="Slotly <bookings@your-verified-domain.com>"
