# Required in production. Generate one with: openssl rand -base64 32
# In development a throwaway default is used (with a console warning).
JWT_SECRET=

# SQLite file location. Defaults: ./data/slotly.db locally, /tmp/slotly.db on Vercel.
# Use ":memory:" for a throwaway database.
# DATABASE_PATH=./data/slotly.db

# Set to 1 to create the demo business (slug: demo-barber) when the database is empty.
# Handy on Vercel, where /tmp is wiped on every cold start.
# SLOTLY_DEMO_SEED=1

# Email: when RESEND_API_KEY is empty, emails are printed to the server console.
# RESEND_API_KEY=
# MAIL_FROM="Slotly <bookings@your-verified-domain.com>"
